{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/style.css", "dest": "/style.css" },
    { "src": "/imge/(.*)", "dest": "/imge/$1" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
