{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/login",
      "dest": "server.js"
    },
    {
      "src": "/api/logout",
      "dest": "server.js"
    },
    {
      "src": "/api/verify",
      "dest": "server.js"
    },
    {
      "src": "/api/admin/generate",
      "dest": "server.js"
    },
    {
      "src": "/api/admin/list",
      "dest": "server.js"
    },
    {
      "src": "/api/admin/toggle",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
